<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/layout_padding"
    android:paddingEnd="@dimen/layout_padding"
    android:paddingTop="@dimen/layout_padding"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_degradadomenu"
    tools:context=".shriavis.menuenfoques.CaptureActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Analisis Superficie"
        android:textColor="@color/color11"
        android:textSize="@dimen/header_text"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp" />

    <!-- Vista de cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@color/color1"
        app:layout_constraintTop_toBottomOf="@+id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.50"
        app:layout_constraintBottom_toTopOf="@+id/layoutSelectorPiscina" />

    <!-- Marco de escaneo -->
    <com.example.visionia.shriavis.efectos.ScannerFrameView
        android:id="@+id/scannerFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview" />

    <!-- Badge IA -->
    <TextView
        android:id="@+id/tvIALista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscando"
        android:textColor="@color/color11"
        android:textSize="12sp"
        android:background="@drawable/bg_tarjeta"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp" />

    <!-- Selector de piscina -->
    <LinearLayout
        android:id="@+id/layoutSelectorPiscina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="-20dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@+id/cameraPreview"
        app:layout_constraintBottom_toTopOf="@+id/btnCapturar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLabelPiscina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccione la piscina"
            android:textColor="@color/color11"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerPiscinas"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@null"
            android:popupBackground="@drawable/bg_spinner_rounded"
            android:paddingHorizontal="12dp" />

    </LinearLayout>

    <!-- Botón Capturar -->
    <FrameLayout
        android:id="@+id/btnCapturar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCapturarImagen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Capturar y Analizar"
            android:textStyle="bold"
            android:textSize="16sp"

            android:textColor="@android:color/white"
            android:background="@drawable/bg_boton"
            android:backgroundTint="@null" />

        <com.example.visionia.shriavis.efectos.GlowButtonBorder
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp" />

    </FrameLayout>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottomnav_height"
        android:orientation="horizontal"
        android:weightSum="4"
        android:background="@color/color14"
        android:paddingTop="4dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/bottomnav_icon"
                android:layout_height="@dimen/bottomnav_icon"
                android:src="@drawable/dashboard"
                android:drawableTint="@color/color_boton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/color11"
                android:textSize="@dimen/bottomnav_text"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCapturar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/bottomnav_icon"
                android:layout_height="@dimen/bottomnav_icon"
                android:src="@drawable/photo_camera"
                app:tint="@color/color_boton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capturar"
                android:textColor="@color/color_boton"
                android:textStyle="bold"
                android:textSize="@dimen/bottomnav_text"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/navAlert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/navAlertas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/bottomnav_icon"
                    android:layout_height="@dimen/bottomnav_icon"
                    android:src="@drawable/notification"
                    android:drawableTint="@color/color11" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alertas"
                    android:textColor="@color/color11"
                    android:textSize="@dimen/bottomnav_text"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/navBanner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:gravity="center"
                android:background="@drawable/bg_icono_tarjeta_rojo_badge"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/bottomnav_icon"
                android:layout_height="@dimen/bottomnav_icon"
                android:src="@drawable/history"
                android:drawableTint="@color/color11" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/color11"
                android:textSize="@dimen/bottomnav_text"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>