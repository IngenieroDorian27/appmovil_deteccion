<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="30dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_degradadomenu"
    tools:context=".shriavis.menuenfoques.HistorialDetalleActivity">

    <TextView
        android:id="@+id/tvDetalleHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalle Historial"
        android:textColor="@color/color11"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tvRevisar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revise por favor"
        android:textColor="@color/color11"
        android:textSize="25sp"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalleHistorial"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />


    <ImageView
        android:id="@+id/ivPerfil"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/logobg"
        android:padding="8dp"
        android:background="@drawable/bg_icono_perfil"
        android:drawableTint="@color/color_boton"
        app:layout_constraintTop_toTopOf="@+id/tvDetalleHistorial"
        app:layout_constraintBottom_toBottomOf="@+id/tvRevisar"
        app:layout_constraintEnd_toEndOf="parent" />


    <ScrollView
        android:id="@+id/scrollDetalle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tvRevisar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/layoutContenidoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/ivImagenCapturada"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_tarjeta"
                android:contentDescription="Imagen capturada"
                android:scaleType="centerCrop"
                android:src="@drawable/logobg"
                android:layout_marginTop="50dp" />

            <TextView
                android:id="@+id/tvAnalisisCompleto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aquí se mostrará el análisis "
                android:textColor="@color/color11"
                android:textSize="16sp"
                android:layout_marginTop="50dp" />

            <TextView
                android:id="@+id/tvPiscinaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Piscina: --"
                android:textColor="@color/color11"
                android:textSize="16sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvFechaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha: --"
                android:textColor="@color/color11"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvHoraDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hora: --"
                android:textColor="@color/color11"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvOperarioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Operario: --"
                android:textColor="@color/color11"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnVerUbicacion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Ver Ubicacion"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_boton"
                android:backgroundTint="@null"
                android:layout_marginTop="24dp" />



        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>