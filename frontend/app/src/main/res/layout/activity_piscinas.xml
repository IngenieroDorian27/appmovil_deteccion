<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="30dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_degradadomenu"
    tools:context=".shriavis.menuenfoques.PiscinasActivity">

    <TextView
        android:id="@+id/tvPiscinaHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Piscinas"
        android:textColor="@color/color11"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tvDetallePiscina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalle Ubicacion"
        android:textColor="@color/color11"
        android:textSize="25sp"
        app:layout_constraintTop_toBottomOf="@+id/tvPiscinaHistorial"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />


    <ImageView
        android:id="@+id/ivPerfil"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/logobg"
        android:padding="8dp"
        android:background="@drawable/bg_icono_perfil"
        android:drawableTint="@color/color_boton"
        app:layout_constraintTop_toTopOf="@+id/tvPiscinaHistorial"
        app:layout_constraintBottom_toBottomOf="@+id/tvDetallePiscina"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etBuscarPiscina"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Buscar por piscina..."
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_boton"
        android:textColor="@color/color1"
        android:textColorHint="@color/color1"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDetallePiscina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPiscinas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@+id/etBuscarPiscina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>